# Copy to .env.local locally or enter in Vercel. Never commit credentials.
SITE_URL=https://tra-coral.vercel.app
# Owner-confirmed origin ZIP; shared shipping configuration is in lib/shipping.ts.
SHIPPING_ORIGIN_POSTAL_CODE=61230
# HTTPS hosted form endpoint; must support multipart uploads and anti-spam.
CUSTOM_ORDER_FORM_ACTION=
# HTTPS email-provider signup endpoint; configure double opt-in and unsubscribe.
WAITLIST_FORM_ACTION=
# See docs/inventory.md for GitHub persistence setup.
INVENTORY_ADMIN_KEY=
INVENTORY_GITHUB_TOKEN=
INVENTORY_BRANCH=main
